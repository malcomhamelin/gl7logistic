---
import Icon from './Icon.astro';
import { company } from '../config';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Besoin de palettes ? Parlons-en.',
  text = `Dites-nous ce qu'il vous faut : nous vous répondons sous ${company.responseTime} avec un prix adapté à vos volumes.`,
} = Astro.props;
---

<section class="cta">
  <div class="container inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn-light" href="/devis">Demander un devis <Icon name="arrow" size={18} /></a>
      <a class="btn btn-outline-light" href={company.phoneHref}><Icon name="phone" size={18} /> {company.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--grad);
    color: #e9e6ff;
    padding-block: clamp(48px, 6vw, 72px);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }
  h2 {
    color: #fff;
    margin-bottom: 8px;
  }
  p {
    margin: 0;
    max-width: 560px;
    font-size: 1.1rem;
  }
</style>
