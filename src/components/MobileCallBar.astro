---
// Barre fixe en bas d'écran sur mobile : appeler en un geste.
import Icon from './Icon.astro';
import { company } from '../config';
---

<div class="callbar">
  <a class="btn btn-primary" href={company.phoneHref}><Icon name="phone" size={18} /> Appeler</a>
  <a class="btn btn-ghost" href="/contact">Être rappelé</a>
</div>

<style>
  .callbar {
    display: none;
  }
  @media (max-width: 1020px) {
    .callbar {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 60;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
      background: rgb(255 255 255 / 0.96);
      backdrop-filter: blur(10px);
      border-top: 1px solid var(--line);
    }
    :global(body) {
      padding-bottom: calc(68px + env(safe-area-inset-bottom));
    }
  }
</style>
