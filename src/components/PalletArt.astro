---
// Illustration isométrique d'une palette, construite à l'échelle à partir de ses dimensions (mm).
//  - euro  : palette Europe / EPAL, la plus massive (gros dés, planches épaisses)
//  - block : construction standard plus fine (100×120, formats hors standard)
//  - light : palette légère (perdue)
//  - half  : demi-palette = palette légère coupée en deux, planches dans le sens de la largeur
import type { Build } from '../data/palettes';

interface Props {
  length?: number;
  width?: number;
  build?: Build;
  stack?: number;
  class?: string;
  label?: string;
}

const { length = 1200, width = 800, build = 'euro', stack = 1, class: className, label } = Astro.props;

type Box = { x: number; y: number; z: number; w: number; d: number; h: number; layer: number };

const C = Math.cos(Math.PI / 6);
const S = 0.5;
const project = (x: number, y: number, z: number): [number, number] => [(x - y) * C, (x + y) * S - z];

function pallet(L: number, W: number, z0: number): { boxes: Box[]; height: number } {
  const boxes: Box[] = [];
  // Sur la demi-palette, semelles et planches de dessus vont dans le sens de la largeur :
  // on construit dans un repère (a = sens des planches, b = travers) puis on fait pivoter.
  const turn = build === 'half';
  const A = turn ? W : L;
  const B = turn ? L : W;
  const add = (a: number, b: number, z: number, wa: number, db: number, h: number, layer: number) =>
    boxes.push(
      turn
        ? { x: b, y: a, z: z + z0, w: db, d: wa, h, layer }
        : { x: a, y: b, z: z + z0, w: wa, d: db, h, layer },
    );

  // Gabarits (mm) : dés (ba × bb × bh), semelles (sw × st), traverses (t), planches de dessus (n × tw × tt)
  const spec = {
    euro: { ba: 145, bb: 130, bh: 78, sw: 110, st: 22, t: 22, n: 5, tw: 120, tt: 22 },
    block: { ba: 95, bb: 90, bh: 78, sw: 90, st: 18, t: 18, n: 6, tw: 90, tt: 18 },
    light: { ba: 90, bb: 85, bh: 78, sw: 80, st: 12, t: 15, n: 4, tw: 90, tt: 12 },
  }[build === 'half' ? 'light' : build];
  const { ba, bb, bh, sw, st, t, n, tw, tt } = spec;
  const as = [0, (A - ba) / 2, A - ba];
  const bs = [0, (B - bb) / 2, B - bb];
  let z = 0;

  // Semelles : 3 planches au sol dans le sens des planches de dessus
  bs.forEach((b) => add(0, b + (bb - sw) / 2, z, A, sw, st, 0));
  z += st;
  as.forEach((a) => bs.forEach((b) => add(a, b, z, ba, bb, bh, 1)));
  z += bh;
  as.forEach((a) => add(a, 0, z, ba, B, t, 2));
  z += t;
  for (let i = 0; i < n; i++) add(0, (i * (B - tw)) / (n - 1), z, A, tw, tt, 3);
  z += tt;
  return { boxes, height: z };
}

const all: Box[] = [];
let z = 0;
for (let i = 0; i < stack; i++) {
  const p = pallet(length, width, z);
  p.boxes.forEach((b) => all.push({ ...b, layer: b.layer + i * 10 }));
  z += p.height;
}

all.sort((a, b) => a.layer - b.layer || a.x + a.w / 2 + a.y + a.d / 2 - (b.x + b.w / 2 + b.y + b.d / 2));

const fmt = (pts: [number, number][]) => pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const faces = all.map(({ x, y, z, w, d, h }) => {
  const x1 = x + w, y1 = y + d, z1 = z + h;
  return {
    top: fmt([project(x, y, z1), project(x1, y, z1), project(x1, y1, z1), project(x, y1, z1)]),
    right: fmt([project(x1, y, z), project(x1, y1, z), project(x1, y1, z1), project(x1, y, z1)]),
    front: fmt([project(x, y1, z), project(x1, y1, z), project(x1, y1, z1), project(x, y1, z1)]),
  };
});

const xsAll = [project(0, width, 0)[0], project(length, 0, 0)[0]];
const minY = project(0, 0, z)[1];
const maxY = project(length, width, 0)[1];
const pad = 12;
const viewBox = `${(xsAll[0] - pad).toFixed(0)} ${(minY - pad).toFixed(0)} ${(xsAll[1] - xsAll[0] + pad * 2).toFixed(0)} ${(maxY - minY + pad * 2).toFixed(0)}`;
---

<svg
  class:list={['pallet-art', className]}
  viewBox={viewBox}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  xmlns="http://www.w3.org/2000/svg"
>
  <g stroke="#8a6236" stroke-width="2" stroke-linejoin="round">
    {
      faces.map((f) => (
        <>
          <polygon points={f.right} fill="#c49663" />
          <polygon points={f.front} fill="#a97c49" />
          <polygon points={f.top} fill="#e8cba3" />
        </>
      ))
    }
  </g>
</svg>

<style>
  .pallet-art {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
