---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { company } from '../../config';

export async function getStaticPaths() {
  const articles = await getCollection('conseils', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

interface Props {
  article: CollectionEntry<'conseils'>;
}
const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, pubDate, updatedDate } = article.data;
const fmt = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' });

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: company.name },
  publisher: { '@id': new URL('/#entreprise', Astro.site).href },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Base title={title} description={description} jsonLd={articleLd}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumb items={[{ label: 'Conseils', href: '/conseils' }, { label: title }]} />
      <h1>{title}</h1>
      <p class="meta">
        Publié le <time datetime={pubDate.toISOString()}>{fmt.format(pubDate)}</time>
        {updatedDate && <> · mis à jour le <time datetime={updatedDate.toISOString()}>{fmt.format(updatedDate)}</time></>}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container layout">
      <article class="prose article">
        <Content />
      </article>
      <aside class="card side">
        <h2>Une question sur vos palettes&nbsp;?</h2>
        <p>Appelez-nous, nous vous conseillons gratuitement.</p>
        <a class="btn btn-primary" href={company.phoneHref}><Icon name="phone" size={18} /> {company.phone}</a>
        <a class="btn btn-ghost" href="/contact">Être rappelé</a>
      </aside>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .meta {
    color: var(--muted);
    margin: 0;
  }
  .layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 56px;
    align-items: start;
  }
  .article :global(h2) {
    margin-top: 1.8em;
  }
  .article :global(h2:first-child) {
    margin-top: 0;
  }
  .article :global(li) {
    margin-bottom: 0.4em;
  }
  .article :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1em 0 1.5em;
    font-size: 0.95rem;
  }
  .article :global(th),
  .article :global(td) {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .article :global(th) {
    color: var(--ink);
    background: var(--bg-soft);
  }
  .side {
    position: sticky;
    top: 100px;
    display: grid;
    gap: 12px;
  }
  .side h2 {
    font-size: 1.15rem;
    margin: 0;
  }
  .side p {
    color: var(--muted);
    margin: 0 0 4px;
  }
  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
    }
  }
</style>
