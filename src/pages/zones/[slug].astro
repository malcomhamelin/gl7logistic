---
import Breadcrumb from '../../components/Breadcrumb.astro';
import Base from '../../layouts/Base.astro';
import PaletteCard from '../../components/PaletteCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { company } from '../../config';
import { palettes } from '../../data/palettes';
import { zones, type Zone } from '../../data/zones';

export function getStaticPaths() {
  return zones.map((zone) => ({ params: { slug: zone.slug }, props: { zone } }));
}

interface Props {
  zone: Zone;
}
const { zone } = Astro.props;
const depot = company.depots.find((d) => d.city === zone.depot);
const label = zone.code === 'IDF' ? zone.name : `${zone.name} (${zone.code})`;
const featured = palettes.filter((p) => p.featured).slice(0, 3);
---

<Base
  title={`Palettes bois ${label} : vente, rachat, réparation`}
  description={`Achat, vente, réparation et rachat de palettes bois ${zone.code === 'IDF' ? 'en' : 'dans le département'} ${label}. Palettes d'occasion Europe, 60×80, 100×120. Livraison et enlèvement par GL7 Logistic.`}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumb items={[{ label: zone.name }]} />
      <h1>Palettes en bois : {label}</h1>
      <p class="lead">{zone.intro}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={company.phoneHref}><Icon name="phone" size={18} /> {company.phone}</a>
        <a class="btn btn-ghost" href="/rachat-palettes">Vendre mes palettes</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cols">
      <div>
        <h2>Communes desservies</h2>
        <p>Nous livrons et enlevons des palettes notamment à :</p>
        <ul class="towns">
          {zone.towns.map((t) => <li>{t}</li>)}
        </ul>
        <p class="muted">Votre commune n'apparaît pas ? Contactez-nous, nous intervenons très probablement chez vous.</p>
      </div>
      <div class="card">
        {
          depot ? (
            <>
              <span class="icon-badge">
                <Icon name="warehouse" />
              </span>
              <h3>{depot.name}</h3>
              <p>
                {depot.street && (<>{depot.street}<br /></>)}
                {depot.postalCode} {depot.city}
              </p>
              <a class="maps" href={depot.mapsUrl} target="_blank" rel="noopener">
                Itinéraire <Icon name="arrow" size={16} />
              </a>
            </>
          ) : (
            <>
              <span class="icon-badge">
                <Icon name="warehouse" />
              </span>
              <h3>Nos dépôts</h3>
              {company.depots.map((d) => (
                <p>
                  <strong>{d.name}</strong>
                  <br />
                  {d.postalCode} {d.city}
                </p>
              ))}
            </>
          )
        }
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <h2>Palettes disponibles {zone.code === 'IDF' ? 'en Île-de-France' : `dans le ${zone.code}`}</h2>
      </div>
      <div class="grid grid-3">
        {featured.map((p) => <PaletteCard palette={p} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Autres zones</h2>
      <div class="chips other">
        {zones.filter((z) => z.slug !== zone.slug).map((z) => <a class="chip" href={`/zones/${z.slug}`}>Palettes {z.name}</a>)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .page-hero .btn-row {
    margin-top: 24px;
  }
  .cols {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: 48px;
    align-items: start;
  }
  .towns {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 8px 20px;
  }
  .towns li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--ink);
  }
  .towns li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--grad);
    flex: none;
  }
  .muted,
  .card p {
    color: var(--muted);
  }
  .maps {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    text-decoration: none;
  }
  .other .chip {
    text-decoration: none;
    font-size: 0.95rem;
    padding: 8px 14px;
  }
  .other .chip:hover {
    border-color: var(--violet);
    color: var(--violet);
  }
  @media (max-width: 860px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
